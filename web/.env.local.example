# Get this from the Privy dashboard: https://dashboard.privy.io
# Public — safe to expose in the browser
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: your own Base RPC endpoints (Alchemy/Infura/etc). Falls back to the
# public Base RPCs if unset — fine for local dev, not recommended for production
# traffic volumes.
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Filled in once Phase 1's contracts are deployed to Base Sepolia
# (see the 1wei-contracts README)
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_COLLECTION_FACTORY_ADDRESS=

# Same, but for Base mainnet — leave blank until you actually deploy there
NEXT_PUBLIC_MARKETPLACE_ADDRESS_MAINNET=
NEXT_PUBLIC_COLLECTION_FACTORY_ADDRESS_MAINNET=

# Pinata JWT — server-only (no NEXT_PUBLIC_ prefix), used by app/api/upload and
# app/api/upload-json to pin images/metadata to IPFS. Create one at pinata.cloud
# under API Keys. Never expose this to the client.
PINATA_JWT=

# Public gateway used to fetch ipfs:// content back out (images, metadata JSON).
# Defaults to Pinata's public gateway if unset.
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
