# Deployer private key (never commit the real .env file)
PRIVATE_KEY=

# RPC endpoints
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Basescan API key, used for `--verify`
BASESCAN_API_KEY=

# Address that receives the 2.5% platform fee cut on every sale
PLATFORM_FEE_RECIPIENT=

# Base predeploy WETH9 — same address on Base Mainnet and Base Sepolia.
# Used as the required payment token for marketplace Offers.
WETH_ADDRESS=0x4200000000000000000000000000000000000006
